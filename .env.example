# Скопируйте в .env и подставьте свои значения. Файл .env не коммитится.

# --- PostgreSQL (используется docker-compose) ---
POSTGRES_DB=medizdeliya
POSTGRES_USER=medizdeliya
POSTGRES_PASSWORD=medizdeliya_local
POSTGRES_PORT=5432

# --- API ---
# Для запуска backend с хоста (npm run start:dev в backend/) хост — localhost.
# Внутри docker-compose хост базы — postgres, этот URL задаётся в compose-файле.
DATABASE_URL=postgresql://medizdeliya:medizdeliya_local@localhost:5432/medizdeliya?schema=public

# Сгенерируйте секреты: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

FRONTEND_ORIGINS=http://localhost:5173
PORT=3000
API_PORT=3000
WEB_PORT=8080
STORAGE_DRIVER=local

# Пароль демонстрационных учётных записей из seed. Только для локальной
# разработки. Если не задан, seed использует dev-only значение и печатает
# предупреждение.
SEED_DEV_PASSWORD=

# --- Внешние источники (все необязательные) ---
# Государственный реестр медицинских изделий: публичный API Росздравнадзора.
# Хост отдаёт сертификат национального УЦ Минцифры, поэтому процессу нужен
# корень из backend/certs — переменная добавляет его к доверенным и НЕ
# отключает проверку сертификатов (ADR 0010). В docker-compose уже задана.
NODE_EXTRA_CA_CERTS=./certs/russian-trusted-ca.pem
REGISTRY_SOURCE_URL=
# Локальная страница ответа вместо обращения к сети (используется тестами).
REGISTRY_LOCAL_FILE=

# Номенклатурная классификация по видам: файловая выгрузка открытых данных.
NOMENCLATURE_SOURCE_URL=
NOMENCLATURE_FILE_NAME=
NOMENCLATURE_LOCAL_FILE=

# Обновление производного кэша аналитики по расписанию (0 — отключить).
ANALYTICS_REFRESH_INTERVAL_MINUTES=15

# Восстановление пароля: HTTPS JSON API с контрактом Resend (POST /emails).
# Без этих настроек recovery/request честно вернёт 503, а не обещание письма.
RECOVERY_EMAIL_API_URL=
RECOVERY_EMAIL_API_KEY=
RECOVERY_EMAIL_FROM=
RECOVERY_RESET_URL=http://localhost:5173/auth/recovery

# Только для команды npm run admin:create после сборки backend.
# Существующие аккаунты эта команда не изменяет и не повышает в правах.
ADMIN_EMAIL=
ADMIN_PASSWORD=
